.env
.env.local
.env.*.local
node_modules/
.DS_Store
Thumbs.db
.claude/tmp/
*.log
tmp-skill-extract/
# Маркер шаблона: untracked, чтобы клиентские клоны его не наследовали (см. .claude/hooks/guard-template-root.sh)
.claude/.is-template-root

# Производные кеши реестров задач (ADR-013): источник истины - per-folder meta.json.
# _index.json пересобирается из meta.json (rebuild-index.mjs) и НЕ коммитится =>
# ноль merge-конфликтов при параллельной работе двух worktree.
articles/_index.json
strategies/_index.json
analyses/_index.json
structures/_index.json
topics/_index.json
metatags/_index.json
texts/_index.json
faq/_index.json

# /site-tekst (задачи texts/NNN-<slug>/ формата v9): копия kit - кеш. Ее кладет .claude/skills/site-tekst/task.mjs
# при каждом старте и --resume, в git она не идет. Данные задачи - в git: meta.json, config/project.json, inputs/, work/,
# rules/decisions.md (решения проекта), overrides/ (проектные правки файлов kit). Список kit - KIT_DIRS/KIT_FILES в task.mjs.
texts/*/.kit.json
texts/*/CLAUDE.md
texts/*/workflows/
texts/*/prompts/
texts/*/scripts/
texts/*/schemas/
texts/*/html/
texts/*/config/house_style.md
texts/*/rules/*
!texts/*/rules/decisions.md
# Конфиг превью панели браузера (task.mjs preview): локальные пути машины, не коммитится
.claude/launch.json
