{
  "$id": "client-preferences",
  "_doc": "work/client-preferences.json. Пишут scripts/import-project.mjs (решения гейта анализа d1-d5, source gate:dN) и 04-strategist-global (пожелания из inputs/client-preferences.md). pages не пишут вовсе, если пожелание для всех страниц: пустой массив build-briefs читает как «ни одной страницы».",
  "type": "object",
  "required": ["items"],
  "properties": {
    "source": { "type": "string" },
    "generated_at": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "status"],
        "properties": {
          "text": { "type": "string", "minLength": 2 },
          "status": { "type": "string", "enum": ["candidate", "basis", "rejected"] },
          "where": { "type": "string" },
          "pages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "reason": { "type": "string" },
          "source": { "type": "string" },
          "facts": { "type": "array", "items": { "type": "string", "pattern": "^F[0-9]{2,3}$" } }
        }
      }
    }
  }
}
