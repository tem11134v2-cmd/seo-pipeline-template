{
  "$id": "state",
  "type": "object",
  "required": ["slug", "blocks_done", "cta", "facts_used", "objections_covered", "blocks_summary", "last_block"],
  "properties": {
    "slug": { "type": "string" },
    "updated_at": { "type": "string" },
    "blocks_done": { "type": "array", "items": { "type": "string" } },
    "next_block": { "type": "string" },
    "cta": { "type": "object", "properties": { "main": { "type": "string" }, "used_in": { "type": "array", "items": { "type": "string" } } } },
    "facts_used": { "type": "array", "items": { "type": "object", "required": ["id", "in"], "properties": { "id": { "type": "string" }, "in": { "type": "array", "items": { "type": "string" } } } } },
    "objections_covered": { "type": "array", "items": { "type": "object", "required": ["id", "in"], "properties": { "id": { "type": "string" }, "in": { "type": "array", "items": { "type": "string" } } } } },
    "client_phrases_used": { "type": "array", "items": { "type": "string" } },
    "blocks_summary": { "type": "array", "items": { "type": "object", "required": ["block_id", "summary"], "properties": { "block_id": { "type": "string" }, "summary": { "type": "string" }, "handoff_note": { "type": "string" } } } },
    "last_block": { "type": "object", "properties": { "block_id": { "type": "string" }, "text": { "type": "string" } } },
    "do_not_repeat": { "type": "array", "items": { "type": "string" } },
    "placeholders_total": { "type": "number" }
  }
}
