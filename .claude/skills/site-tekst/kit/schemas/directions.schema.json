{
  "$id": "directions",
  "_doc": "work/directions.json - направления бизнеса из project.json (business.directions) с сегментами в нумерации текстов (S1..). Пишет scripts/import-project.mjs, читает 01-sitemap-enricher: страница с «dir:<id>» в notes или с url направления получает segment из serves.",
  "type": "object",
  "required": ["source", "directions"],
  "properties": {
    "source": { "type": "string" },
    "directions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "serves"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
          "name": { "type": "string", "minLength": 2 },
          "parent": { "type": "string" },
          "marker": { "type": "string" },
          "url": { "type": "string" },
          "serves": { "type": "array", "items": { "type": "string", "pattern": "^S[0-9]$" } },
          "geo": { "type": "string" }
        }
      }
    }
  }
}
