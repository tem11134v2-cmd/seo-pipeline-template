{
  "$id": "competitors",
  "type": "object",
  "required": ["verified_at", "competitors"],
  "properties": {
    "verified_at": { "type": "string" },
    "method": { "type": "string" },
    "degraded": { "type": "string", "enum": ["no_competitors"], "description": "Все кандидаты ответили, но недоступны (HTTP-код, страница проверки, пустая страница в браузере): типы собираются по анализу без конкурентов, отчет задает заказчику вопрос о 2-3 сайтах-ориентирах. Сбой среды (сеть, инструмент выдачи или браузера) - не деградация: поле не ставится." },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "status", "source"],
        "properties": {
          "domain": { "type": "string" },
          "home_url": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "js_only", "antibot", "closed", "aggregator", "excluded"] },
          "source": { "type": "string", "enum": ["analysis", "serp", "both", "structure", "keyso"], "description": "analysis - затравка анализа, serp - выдача, both - анализ и выдача, structure - конкуренты структуры SEO, keyso - добор Keys.so (domain_competitors)" },
          "rank": { "type": "number", "description": "место в ranking.json -> order (отбор по ranking.json)" },
          "weight": { "description": "вес W 0-100 из ranking.json или null" },
          "age_years": { "description": "возраст домена в годах или null" },
          "age_class": { "type": "string", "enum": ["young", "mid", "old", "unknown"] },
          "growth": { "type": "string", "enum": ["up", "flat", "down", "unknown"] },
          "site_type": { "type": "string", "enum": ["multipage_leader", "medium", "small", "landing", "unknown"] },
          "anchor": { "type": "boolean", "description": "кандидат-эталон из ranking.json -> anchors" },
          "reason": { "type": "string" },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "type", "raw", "status"],
              "properties": {
                "url": { "type": "string" },
                "type": { "type": "string" },
                "raw": { "type": "string" },
                "status": { "type": "string", "enum": ["ok", "js_only", "antibot", "closed", "browser"] },
                "chars": { "type": "number" },
                "headings": { "type": "number" },
                "flat": { "type": "boolean" },
                "verbatim": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
