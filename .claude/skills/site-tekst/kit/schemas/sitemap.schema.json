{
  "$id": "sitemap",
  "type": "object",
  "required": ["source", "page_types", "pages"],
  "properties": {
    "source": { "type": "string" },
    "generated_at": { "type": "string" },
    "page_types": { "type": "array", "items": { "type": "string" } },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "url", "type", "subject", "level", "status"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "url": { "type": "string" },
          "type": { "type": "string", "enum": ["home", "hub", "category", "service", "product", "info_about", "info_contacts", "info_team", "info_reviews", "info_cases", "info_faq", "info_other"] },
          "subject": { "type": "string", "minLength": 2 },
          "parent": { "type": "string" },
          "level": { "type": "number" },
          "geo": { "type": "string" },
          "segment": { "type": "string" },
          "facts_available": { "type": "array", "items": { "type": "string" } },
          "fact_coverage": { "type": "number" },
          "block_set": { "type": "string", "enum": ["full", "short"] },
          "listing": { "type": "boolean" },
          "wave": { "type": "number" },
          "status": { "type": "string", "enum": ["planned", "skip", "briefed", "written", "judged", "done", "blocked"] },
          "source_h1": { "type": "string" },
          "source_queries": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
